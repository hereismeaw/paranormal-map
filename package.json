{
  "name": "paranormal-activity",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env --import tsx scripts/seed.ts",
    "admin:create": "node --env-file-if-exists=.env --import tsx scripts/create-admin.ts",
    "media:worker": "node --env-file-if-exists=.env --import tsx scripts/media-worker.ts",
    "retention:purge": "node --env-file-if-exists=.env --import tsx scripts/purge.ts",
    "test:integration": "node --env-file-if-exists=.env --import tsx scripts/test-integration.ts",
    "predev": "node scripts/sync-map-assets.mjs",
    "prebuild": "node scripts/sync-map-assets.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/geojson": "7946.0.16",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@hookform/resolvers": "5.9.2",
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/react-query": "5.104.5",
    "better-auth": "1.7.11",
    "drizzle-orm": "0.45.4",
    "file-type": "22.2.0",
    "ioredis": "6.0.0",
    "lucide-react": "1.59.0",
    "maplibre-gl": "6.15.0",
    "motion": "14.4.0",
    "next": "16.4.2",
    "next-intl": "4.14.9",
    "postgres": "3.4.9",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "sharp": "0.35.5",
    "sonner": "2.0.8",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "type": "module"
}
