# Copy to .env. This file contains examples, never real credentials.
DATABASE_URL=postgres://paranormal:change-this-database-password@postgres:5432/paranormal
POSTGRES_USER=paranormal
POSTGRES_DB=paranormal
POSTGRES_PASSWORD=change-this-database-password
REDIS_URL=redis://valkey:6379
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MAP_STYLE_URL=/map-style.json
NEXT_PUBLIC_MAPTILER_API_KEY=
# Optional. Defaults to public Nominatim; send a valid User-Agent and keep one request per second.
GEOCODER_URL=https://nominatim.openstreetmap.org
# Real keys required for production. See README for Cloudflare development test keys.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAME=localhost
TURNSTILE_CHECK_ACTION=true
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=paranormal-evidence
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=paranormal-storage
S3_SECRET_ACCESS_KEY=change-this-storage-password
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
# Do not put the admin password here. The bootstrap command reads stdin.
TRUST_PROXY=false
TRUSTED_IP_HEADER=cf-connecting-ip
REPORTS_PER_IP_HOUR=3
REPORTS_PER_IP_DAY=10
REPORTS_PER_GUEST_HOUR=5
UPLOADS_PER_HOUR=12
DUPLICATE_RADIUS_METERS=50
SPAM_REJECT_SCORE=70
MAX_UPLOAD_BYTES=20971520
RETENTION_DAYS=90
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
